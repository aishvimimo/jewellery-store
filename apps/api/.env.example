NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://store:local-development-only@localhost:5432/jewellery
# Use Railway's private DATABASE_URL in production.
# Set require only for a provider that requires verified TLS; never disable verification.
DATABASE_SSL=disable
DB_POOL_MAX=5
CORS_ORIGINS=http://localhost:4321
# Enable only behind Railway's trusted proxy, after confirming client IP behavior.
TRUST_PROXY=false

# Admin settings (defaults work locally; no default admin account exists).
ADMIN_SESSION_HOURS=8
ADMIN_COOKIE_SAMESITE=lax
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.data/media
MEDIA_PUBLIC_URL=http://localhost:3001/media
# Production R2: set MEDIA_DRIVER=r2 and MEDIA_PUBLIC_URL=https://images.example.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional Cloudflare Pages deploy hook, kept on the backend only.
# PAGES_DEPLOY_HOOK_URL=

# Test orders still reduce inventory. Cancel them from admin to restore stock.
ORDERS_MODE=test
# Live COD checkout requires verified courier PIN prefixes or exact PIN codes.
SHIPPING_PIN_PREFIXES=

# Online payment integration is test-only. Existing COD checkout works when disabled.
RAZORPAY_MODE=disabled
# Fill these in apps/api/.env only; never put secrets in Pages/frontend settings.
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_test_api_secret
# RAZORPAY_WEBHOOK_SECRET=choose_a_random_secret_at_least_16_characters
# RAZORPAY_PREVIOUS_WEBHOOK_SECRET=optional_previous_secret_for_retries
PAYMENT_RESERVATION_MINUTES=30

# Accounts and email: local defaults create protected admin previews; nothing is emailed.
CUSTOMER_SESSION_HOURS=24
CUSTOMER_COOKIE_SAMESITE=lax
EMAIL_DRIVER=local
EMAIL_SITE_URL=http://localhost:4321
EMAIL_FROM=store@example.test
# Production: EMAIL_DRIVER=resend, verified sender EMAIL_FROM, HTTPS EMAIL_SITE_URL.
# RESEND_API_KEY=
# Production requires a unique 64-character hexadecimal encryption key; preserve it on updates.
# EMAIL_ENCRYPTION_KEY=
RETURN_WINDOW_DAYS=14
