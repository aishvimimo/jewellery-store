# Fill these in Railway, never in frontend configuration.
NODE_ENV=production
HOST=0.0.0.0
# Railway supplies PORT. Reference the PostgreSQL service private DATABASE_URL.
DATABASE_URL=postgresql://REPLACE_WITH_PRIVATE_DATABASE_CONNECTION
DATABASE_SSL=disable
DB_POOL_MAX=5
TRUST_PROXY=false
CORS_ORIGINS=https://shop.example.com
EMAIL_SITE_URL=https://shop.example.com
ADMIN_COOKIE_SAMESITE=lax
CUSTOMER_COOKIE_SAMESITE=lax
ORDERS_MODE=test
RAZORPAY_MODE=disabled
MEDIA_DRIVER=r2
MEDIA_PUBLIC_URL=https://images.example.com
R2_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_BUCKET
R2_ACCESS_KEY_ID=REPLACE_PRIVATELY
R2_SECRET_ACCESS_KEY=REPLACE_PRIVATELY
# Start with disabled for infrastructure-only testing; accounts require Resend.
EMAIL_DRIVER=disabled
EMAIL_ENCRYPTION_KEY=REPLACE_WITH_PRIVATE_64_CHARACTER_HEX_KEY
# Preserve the original key if importing encrypted queued email payloads.
# EMAIL_DRIVER=resend
# EMAIL_FROM=orders@example.com
# RESEND_API_KEY=REPLACE_PRIVATELY
RETURN_WINDOW_DAYS=14
