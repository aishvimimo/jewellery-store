{
    "$schema":  "https://railway.com/railway.schema.json",
    "build":  {
                  "builder":  "DOCKERFILE",
                  "dockerfilePath":  "Dockerfile.api"
              },
    "deploy":  {
                   "startCommand":  "npm run start -w @store/api",
                   "healthcheckPath":  "/ready",
                   "healthcheckTimeout":  60,
                   "restartPolicyType":  "ON_FAILURE",
                   "restartPolicyMaxRetries":  5,
                   "preDeployCommand":  [
                                            "sh -c \"npm run db:migrate:production -w @store/api \u0026\u0026 node apps/api/dist/rotate-email-key-cli.js --from-development-fallback\""
                                        ]
               }
}